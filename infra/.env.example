# Docker / backend runtime configuration.
APP_ENV=production
# FitPlan binds to the server loopback interface and is exposed through 1Panel/OpenResty.
# Change this if port 18081 is already occupied.
FITPLAN_HTTP_PORT=18081
# Use a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# Use a different long random value to encrypt each user's saved DingTalk credentials.
# The application hashes this value into the Fernet key format, so a 32-byte hex string is sufficient.
NOTIFICATION_ENCRYPTION_KEY=replace-with-another-long-random-secret
# Use a strong database password. URL-encode it if you later use it inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# OpenAI-compatible relay API (optional; without these values, AI functions return a clear configuration error).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Global DingTalk custom robot fallback (optional).
# Individual users can save their own DingTalk robot settings in the web UI.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# Every day in Asia/Shanghai time.
DINGTALK_DAILY_PUSH_HOUR=8
DINGTALK_DAILY_PUSH_MINUTE=0

# Local development helpers only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
